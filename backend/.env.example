# ===== 应用配置 =====
APP_NAME=秋招助手后端
APP_ENV=development
# development / production
DEBUG=true
API_V1_PREFIX=/api/v1

# 后端服务地址（用于 OAuth 回调、邮件链接等）
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8080"]

# ===== 数据库 =====
# PostgreSQL (asyncpg) 生产环境
DATABASE_URL=postgresql+asyncpg://campus:campus123@localhost:5432/campus_recruitment
# SQLite 本地开发（二选一，注释其一）
# DATABASE_URL=sqlite+aiosqlite:///./campus_recruit.db

# ===== JWT 配置 =====
# 请在生产环境生成强随机密钥：openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Cookie 配置 =====
# JWT 使用 httpOnly cookie 存储
COOKIE_SECURE=false
# 生产环境设为 true，要求 HTTPS
COOKIE_SAMESITE=lax

# ===== AI 配置 =====
# 系统默认 AI 提供商（DeepSeek）
# 用户也可在前端「AI 设置」页面自行添加其他 AI 提供商
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 每用户每日 AI 生成次数上限
AI_DAILY_LIMIT=10

# 用户可在前端配置的 AI 提供商（无需在此设置）：
# - OpenAI (GPT-4o / GPT-4o-mini)
# - 通义千问 (Qwen)
# - 智谱 GLM (GLM-4 / GLM-3-Turbo)
# - Moonshot Kimi
# - 百川 (Baichuan)
# - 零一万物 (Yi)
# - 任意兼容 OpenAI 接口的自定义服务商

# ===== GitHub OAuth 配置 =====
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ===== 邮件服务（Resend / SMTP）=====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com

# ===== Redis（缓存 + 限流，可选）=====
REDIS_URL=redis://localhost:6379/0

# ===== 爬虫配置（可选）=====
# GitHub Token 用于提升 API 速率限制（推荐配置）
GITHUB_TOKEN=ghp_your-github-token

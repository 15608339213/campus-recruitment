# ============================================================
# 秋招助手 - 环境变量配置示例
#
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改下方配置项为你的实际值
#   3. 后端会自动读取 backend/.env，前端读取 frontend/.env
#   4. Docker Compose 会读取根目录 .env 中的变量
# ============================================================

# ===== Database =====
# PostgreSQL 异步连接（asyncpg 驱动）
# 用户名/密码/数据库名对应 docker-compose.yml 中的配置
DATABASE_URL=postgresql+asyncpg://campus:campus123@localhost:5432/campus_recruitment

# ===== Redis =====
# 用于缓存、限流、会话管理
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
# 生产环境务必生成强随机密钥：openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== AI 配置 =====
# 系统默认 AI 提供商（DeepSeek）
# 注意：用户可在前端「AI 设置」页面自行添加任意 AI 提供商
# 支持 OpenAI、通义千问、智谱GLM、Kimi、百川、零一万物等
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_LIMIT=10

# ===== OAuth =====
# GitHub OAuth 应用配置（https://github.com/settings/developers）
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===== 爬虫配置 =====
# GitHub Token 用于提升 API 速率限制（https://github.com/settings/tokens）
GITHUB_TOKEN=ghp-your-github-token

# ===== Email =====
# SMTP 邮件服务（用于验证码、通知邮件）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=noreply@campus-recruitment.com

# ===== Frontend =====
# 前端开发服务器地址（Vite 默认端口 5173）
FRONTEND_URL=http://localhost:5173
# 后端 API 服务地址
BACKEND_URL=http://localhost:8000
